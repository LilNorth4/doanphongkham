# Sao chép file này thành ".env" rồi điền mật khẩu MySQL của bạn.
# Spring Boot (backend) và Docker Compose đều đọc file .env ở thư mục gốc này.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=phongkham

# Chế độ thử: xem mã OTP / mật khẩu tạm trong hộp thư giả lập trên giao diện (không bật khi triển khai thật)
CHE_DO_THU=1

# Dữ liệu thử: Flyway nạp thêm dữ liệu demo khi tạo CSDL lần đầu (mật khẩu mọi tài khoản: Phongkham123)
DU_LIEU_THU=1

# Cổng mở giao diện web khi chạy bằng Docker Compose
WEB_PORT=80

# Tùy chọn: kết nối bằng một chuỗi thay cho DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
